# Optional — only needed for the explain_settlement_decision tool.
# The other three tools (get_sequencer_safety, get_oracle_state,
# get_rwa_settlement_signal) work with no configuration at all.
#
# Get a free key at https://openrouter.ai/keys — copy to .env and fill in.
# NEVER commit .env (it's gitignored at the repo root already).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
